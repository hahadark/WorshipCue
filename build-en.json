{
  "appId": "org.worshipcue.app",
  "productName": "WorshipCue",
  "files": [
    "src/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "data-en/bible.db",
      "to": "bible.db"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "WorshipCue",
    "artifactName": "WorshipCue-${version}-English-Setup.${ext}"
  },
  "directories": {
    "output": "dist-en"
  },
  "portable": {
    "artifactName": "WorshipCue-${version}-English-Portable.${ext}"
  },
  "electronLanguages": [
    "ko",
    "en-US"
  ],
  "compression": "maximum",
  "extraMetadata": {
    "worshipcueLang": "en"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.productivity",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "extendInfo": {
      "NSCameraUsageDescription": "카메라(웹캠·캡처보드) 화면을 예배 화면 배경으로 보여 주기 위해 사용합니다. / Used to show your camera on the worship screen.",
      "NSMicrophoneUsageDescription": "마이크는 사용하지 않습니다. / The microphone is not used."
    }
  },
  "dmg": {
    "artifactName": "WorshipCue-${version}-English-mac-${arch}.${ext}"
  },
  "afterPack": "build/adhoc-sign.js",
  "publish": [
    {
      "provider": "github",
      "owner": "hahadark",
      "repo": "WorshipCue",
      "releaseType": "release"
    }
  ]
}
