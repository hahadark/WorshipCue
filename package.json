{
  "name": "worshipcue",
  "productName": "WorshipCue",
  "version": "1.9.0",
  "description": "교회 예배 순서(큐시트) 통합 송출 프로그램 — 성경·찬양 가사·공지·제목·이미지",
  "main": "src/main/main.js",
  "author": "WorshipCue",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "headless": "node src/headless.js",
    "test": "node --test tests/core.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "import": "node tools/import.js",
    "dist": "electron-builder --win",
    "dist:personal": "electron-builder --win --config build-personal.json",
    "import:bethlehem": "node tools/import-bethlehem.js",
    "import:commentary": "node tools/import-commentary.js",
    "dist:en": "electron-builder --win portable --config build-en.json",
    "i18n": "node tools/i18n-extract.js && node tools/i18n-build.js",
    "dist:mac": "electron-builder --mac",
    "dist:mac:en": "electron-builder --mac --config build-en.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.worshipcue.app",
    "productName": "WorshipCue",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/bible.db",
        "to": "bible.db"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WorshipCue",
      "artifactName": "WorshipCue-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    },
    "portable": {
      "artifactName": "WorshipCue-${version}-Portable.${ext}"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "카메라(웹캠·캡처보드) 화면을 예배 화면 배경으로 보여 주기 위해 사용합니다. / Used to show your camera on the worship screen.",
        "NSMicrophoneUsageDescription": "마이크는 사용하지 않습니다. / The microphone is not used."
      }
    },
    "dmg": {
      "artifactName": "WorshipCue-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "build/adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "hahadark",
        "repo": "WorshipCue",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
