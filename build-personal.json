{
  "appId": "org.worshipcue.app",
  "productName": "WorshipPresenter",
  "files": [
    "src/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "data-personal/bible.db",
      "to": "bible.db"
    },
    {
      "from": "data-personal/새찬송가.hdb",
      "to": "새찬송가.hdb"
    },
    {
      "from": "data-personal/새찬송가.cmp",
      "to": "새찬송가.cmp"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "워십프리젠터",
    "artifactName": "WorshipPresenter-${version}-개인용-Setup.${ext}"
  },
  "directories": {
    "output": "dist-personal"
  },
  "portable": {
    "artifactName": "WorshipPresenter-${version}-개인용-Portable.${ext}"
  },
  "electronLanguages": [
    "ko",
    "en-US"
  ],
  "compression": "maximum",
  "extraMetadata": {
    "worshipcuePersonal": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "hahadark",
      "repo": "WorshipCue",
      "releaseType": "release"
    }
  ]
}
